<Window
    x:Class="MusicPower3.MainWindow"
    x:Name="ThisWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicPower3"
    xmlns:models="using:MusicPower3.Models"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="Music Power 3">

    <Window.SystemBackdrop><MicaBackdrop Kind="Base" /></Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle><Rectangle.Fill><AcrylicBrush TintColor="#000000" TintOpacity="0.75" FallbackColor="#0A0A0A"/></Rectangle.Fill></Rectangle>
        </Grid>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" />
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE8D6;" FontSize="14" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Music Power 3" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="20,0,20,12">
            <Border Background="#33000000" BorderBrush="Transparent" BorderThickness="0" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" x:Name="ColNowPlaying"/>
                    </Grid.ColumnDefinitions>

                    <tk:LayoutTransformControl Grid.Column="0">
                        <tk:LayoutTransformControl.Transform><ScaleTransform x:Name="LibraryTransform" ScaleX="1.0" ScaleY="1.0"/></tk:LayoutTransformControl.Transform>

                        <Grid>
                            <Grid x:Name="LibraryContainer" Padding="24">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Library" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                        <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind IsLoading, Mode=OneWay}" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" Width="24" Height="24" VerticalAlignment="Center"/>
                                        
                                        <Button x:Name="BatchEditExecuteBtn" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="18" Padding="8" Click="OnBatchEditExecuteClick" ToolTipService.ToolTip="Edit Selected Tracks" Visibility="Collapsed" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                        <Button x:Name="SelectionModeToggleBtn" Content="&#xE710;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="18" Padding="8" Click="OnSelectionModeToggleClick" ToolTipService.ToolTip="Select Multiple Tracks"/>
                                        <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="18" Padding="8" Click="OnScanLibraryClick" ToolTipService.ToolTip="Scan Folder for New Tracks"/>
                                        <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="18" Padding="8" Click="OnSettingsClick" ToolTipService.ToolTip="Settings"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search tracks..." TextChanged="OnSearchTextChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SearchCountText" Grid.Column="1" Text="" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                    
                                    <ComboBox x:Name="SortBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="OnSortChanged" Width="220" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Title (A-Z)"/>
                                        <ComboBoxItem Content="Title (Z-A)"/>
                                        <ComboBoxItem Content="Artist (A-Z)"/>
                                        <ComboBoxItem Content="Artist (Z-A)"/>
                                        <ComboBoxItem Content="Album (A-Z)"/>
                                        <ComboBoxItem Content="Album (Z-A)"/>
                                        <ComboBoxItem Content="Date Added (Newest)"/>
                                        <ComboBoxItem Content="Date Added (Oldest)"/>
                                        <ComboBoxItem Content="Date Modified (Newest)"/>
                                        <ComboBoxItem Content="Date Modified (Oldest)"/>
                                        <ComboBoxItem Content="Duration (Longest)"/>
                                        <ComboBoxItem Content="Duration (Shortest)"/>
                                    </ComboBox>
                                </Grid>
                                
                                <ListView x:Name="LibraryList" Grid.Row="2" ItemsSource="{x:Bind LibraryTracks, Mode=OneWay}" SelectedItem="{x:Bind NowPlayingTrack, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnTrackItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Track">
                                            <Grid Padding="8,12" HorizontalAlignment="Stretch" CornerRadius="8">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Edit Metadata..." Click="OnEditTrackMenuClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons"/></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="Play Next (Queue)" Click="OnQueueNextClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE893;" FontFamily="Segoe Fluent Icons"/></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Play Now" Click="OnPlayNowClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons"/></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8" Background="#202741" Margin="0,0,20,0">
                                                    <Grid CornerRadius="8">
                                                        <Image Source="{x:Bind ArtworkImage, Mode=OneWay}" Stretch="UniformToFill" Width="56" Height="56"/>
                                                        <Border Background="#88000000" Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="{x:Bind PlayPauseGlyph, Mode=OneWay}" FontSize="20" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight, Mode=OneWay}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Artist}" FontSize="14" Opacity="0.7" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayDuration}" FontSize="14" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <Grid x:Name="EditOverlay" Visibility="Collapsed" Padding="24" Margin="0,0,12,0">
                                <Border CornerRadius="12" BorderBrush="Transparent" BorderThickness="0">
                                    <Border.Background><AcrylicBrush TintColor="#0A0A0A" TintOpacity="0.95" FallbackColor="#1A1A1A" /></Border.Background>
                                </Border>
                                
                                <Grid Padding="32">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock x:Name="EditOverlayTitle" Text="Edit Track Info" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>
                                    
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                                            
                                            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="MetadataUrlBox" Grid.Column="0" PlaceholderText="Paste a Spotify, YouTube, or SoundCloud link here..." VerticalAlignment="Center"/>
                                                <Button x:Name="FetchMetadataBtn" Grid.Column="1" Content="Fetch" Click="OnFetchMetadataClick" VerticalAlignment="Center"/>
                                                <ProgressRing x:Name="FetchProgressRing" Grid.Column="2" IsActive="False" Width="24" Height="24" Visibility="Collapsed" VerticalAlignment="Center"/>
                                            </Grid>
                                            
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,16"/>

                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0" Spacing="8">
                                                    <Border Width="160" Height="160" CornerRadius="8" Background="#22FFFFFF">
                                                        <Image x:Name="EditArtworkPreview" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Button Content="Choose Image..." HorizontalAlignment="Stretch" Click="OnEditArtworkClick"/>
                                                    <Button Content="Clear Artwork" HorizontalAlignment="Stretch" Click="OnClearArtworkClick"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" Spacing="12">
                                                    <TextBox x:Name="EditTitleBox" Header="Title" />
                                                    <TextBox x:Name="EditArtistBox" Header="Artist (Performers, separated by ;)" />
                                                    <TextBox x:Name="EditAlbumBox" Header="Album" />
                                                    <TextBox x:Name="EditAlbumArtistBox" Header="Album Artist (separated by ;)" />
                                                </StackPanel>
                                            </Grid>
                                            
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <NumberBox x:Name="EditTrackBox" Grid.Column="0" Header="Track #" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox x:Name="EditDiscBox" Grid.Column="1" Header="Disc #" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox x:Name="EditYearBox" Grid.Column="2" Header="Year" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                            </Grid>
                                            
                                            <TextBox x:Name="EditGenreBox" Header="Genre (separated by ;)" />
                                            <TextBox x:Name="EditCommentBox" Header="Comment" AcceptsReturn="True" Height="80"/>
                                            
                                            <TextBlock x:Name="EditErrorText" Foreground="#FF6666" Visibility="Collapsed" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,24,0,0">
                                        <Button Content="Cancel" Click="OnCancelEditClick" Width="100"/>
                                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSaveEditClick" Width="100"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </tk:LayoutTransformControl>

                    <Border Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" Background="#11000000" CornerRadius="0,12,12,0">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="1000" Height="1000" CornerRadius="0,12,12,0" Background="#11000000">
                                <Grid CornerRadius="0,12,12,0">
                                    <Image Source="{x:Bind NowPlayingTrack.HighResArtworkImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                    <Border Background="#66000000" Visibility="{x:Bind GetFallbackVisibility(NowPlayingTrack), Mode=OneWay}"/>
                                    <TextBlock Text="No Track Playing" Visibility="{x:Bind GetFallbackVisibility(NowPlayingTrack), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#88FFFFFF" FontSize="64"/>
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Border>

                    <Grid Grid.ColumnSpan="2" x:Name="SettingsOverlay" Visibility="Collapsed" CornerRadius="12">
                        <Border CornerRadius="12" BorderBrush="Transparent" BorderThickness="0">
                            <Border.Background><AcrylicBrush TintColor="#0A0A0A" TintOpacity="0.7" FallbackColor="#1A1A1A" /></Border.Background>
                        </Border>
                        <Grid Padding="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                                <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="OnSettingsClick"/>
                            </Grid>

                            <ScrollViewer x:Name="SettingsScrollHost" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SettingsScrollHost_SizeChanged">
                                <Viewbox x:Name="SettingsViewbox" Stretch="Uniform" StretchDirection="DownOnly">
                                    <Grid MaxWidth="760" ColumnSpacing="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="24">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Library Management" FontSize="16" FontWeight="SemiBold"/>
                                            <Button Content="Add Directory Folder" Click="OnAddFolderClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                            <Button Content="Scan Current Folder for New Tracks" Click="OnScanLibraryClick" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Advanced Random Playback" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="Exclude tracks last modified outside this range:" FontSize="12" Opacity="0.6"/>
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <CalendarDatePicker x:Name="RandomStartPicker" Header="From Date" DateChanged="RandomDates_Changed"/>
                                                <CalendarDatePicker x:Name="RandomEndPicker" Header="To Date" DateChanged="RandomDates_Changed"/>
                                            </StackPanel>

                                            <NumberBox x:Name="ShuffleMemoryBox"
                                                       Header="Shuffle Memory (tracks played before a repeat is allowed)"
                                                       Minimum="0"
                                                       SpinButtonPlacementMode="Compact"
                                                       SmallChange="1"
                                                       LargeChange="10"
                                                       AcceptsExpression="False"
                                                       ValueChanged="ShuffleMemoryBox_ValueChanged"/>
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Interface &amp; Layout" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="Global Interface Scale" FontSize="12" Opacity="0.6" Margin="0,8,0,0"/>
                                            <local:AudioProgressBar x:Name="GlobalScaleSlider" Minimum="0.75" Maximum="1.5" Value="1.0" StepFrequency="0.05" IsThumbAlwaysVisible="True" ValueChanged="GlobalScaleSlider_ValueChanged" ScrubbingEnded="GlobalScaleSlider_ScrubbingEnded"/>
                                            <ToggleSwitch x:Name="ToggleArtworkPanelSwitch" Header="Show Large Artwork Panel" IsOn="True" Toggled="OnViewToggled" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <TextBlock Text="Theme &amp; Accent Color" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Customize the color of all timeline and control bars:" FontSize="12" Opacity="0.6"/>
                                        <ColorPicker x:Name="AppColorPicker"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="True"
                                                     IsHexInputVisible="True"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="True"
                                                     IsAlphaTextInputVisible="True"
                                                     ColorChanged="OnAccentColorChanged"
                                                     HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    </Grid>
                                </Viewbox>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#33000000" BorderBrush="Transparent" BorderThickness="0" CornerRadius="12" Padding="32,24" Margin="20,0,20,20">
            <tk:LayoutTransformControl HorizontalAlignment="Stretch">
                <tk:LayoutTransformControl.Transform><ScaleTransform x:Name="TransportTransform" ScaleX="1.0" ScaleY="1.0"/></tk:LayoutTransformControl.Transform>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,20,20" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="CurrentTimeText" Text="0:00" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        
                        <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <local:AudioProgressBar x:Name="ProgressSlider"
                                                    Minimum="0" Maximum="100" Value="0"
                                                    ValueChanged="ProgressSlider_ValueChanged"
                                                    PointerPressed="ProgressSlider_PointerPressed"
                                                    PointerReleased="ProgressSlider_PointerReleased"
                                                    Loaded="ProgressSlider_Loaded"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                        
                        <TextBlock Grid.Column="2" x:Name="TotalTimeText" Text="-:--" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="32">
                        <!-- FIX: Converted ToggleButton to standard Button to prevent Windows overriding the theme -->
                        <Button x:Name="ShuffleBtn" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="16" Click="ShuffleBtn_Click">
                            <TextBlock x:Name="ShuffleIcon" Text="&#xE8B1;" FontFamily="Segoe Fluent Icons"/>
                        </Button>
                        <Button Click="OnPreviousClick" Content="&#xE892;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <Button x:Name="PlayPauseButton" Style="{ThemeResource AccentButtonStyle}" Width="80" Height="56" CornerRadius="16" BorderThickness="0" Padding="0" Click="OnPlayPauseClick">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="26"/>
                        </Button>
                        
                        <Button Click="OnNextClick" Content="&#xE893;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Button x:Name="RepeatBtn" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" FontSize="16" Click="RepeatBtn_Click">
                            <TextBlock x:Name="RepeatIcon" Text="&#xE8EE;" FontFamily="Segoe Fluent Icons"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                        <local:AudioProgressBar x:Name="VolumeSlider"
                                                AutomationProperties.Name="Volume"
                                                Orientation="Vertical"
                                                Height="100" Width="24"
                                                Minimum="0" Maximum="100" StepFrequency="1" Value="100"
                                                ValueChanged="VolumeSlider_ValueChanged"
                                                ScrubbingEnded="VolumeSlider_ScrubbingEnded"/>
                        <FontIcon Glyph="&#xE767;" FontSize="14" Opacity="0.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </tk:LayoutTransformControl>
        </Border>
    </Grid>
</Window>