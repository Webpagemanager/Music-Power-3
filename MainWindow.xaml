<Window
    x:Class="MusicPower3.MainWindow"
    x:Name="ThisWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicPower3"
    xmlns:models="using:MusicPower3.Models"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="Music Power 3">

    <Window.SystemBackdrop><MicaBackdrop Kind="Base" /></Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">

        <Grid.Resources>
            <!-- Native Windows 11 card surfaces: all colours come from the system theme, so light/dark/high-contrast just work. -->
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
        </Grid.Resources>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Expanded">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Two-column settings cards on wide windows. -->
                        <Setter Target="AppearanceCard.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="PlaybackCard.(Grid.Column)" Value="1"/>
                        <Setter Target="PlaybackCard.(Grid.Row)" Value="0"/>
                        <Setter Target="PlaybackCard.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="LibraryCard.(Grid.Row)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Narrow windows: drop the artwork panel and the mini player text, single settings column. -->
                        <Setter Target="ArtworkPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="NowPlayingInfo.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" />
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Left" Spacing="8" IsHitTestVisible="False">
            <Image Source="ms-appx:///Assets/icon.ico" Width="16" Height="16"/>
            <TextBlock Text="Music Power 3" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Padding="16,0,16,12">
            <tk:LayoutTransformControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <tk:LayoutTransformControl.Transform><ScaleTransform x:Name="ContentTransform" ScaleX="1.0" ScaleY="1.0"/></tk:LayoutTransformControl.Transform>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid x:Name="LibraryContainer" Padding="20">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Library" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind IsLoading, Mode=OneWay}" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <Button x:Name="BatchQueueNextBtn" Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE893;" Click="OnBatchQueueNextClick" ToolTipService.ToolTip="Play selected tracks next" AutomationProperties.Name="Play selected tracks next" Visibility="Collapsed"/>
                                        <Button x:Name="BatchQueueLastBtn" Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE710;" Click="OnBatchQueueLastClick" ToolTipService.ToolTip="Add selected tracks to queue" AutomationProperties.Name="Add selected tracks to queue" Visibility="Collapsed"/>
                                        <Button x:Name="BatchEditExecuteBtn" Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE70F;" Click="OnBatchEditExecuteClick" ToolTipService.ToolTip="Edit selected tracks" AutomationProperties.Name="Edit selected tracks" Visibility="Collapsed" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <Button x:Name="SelectionModeToggleBtn" Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE762;" Click="OnSelectionModeToggleClick" ToolTipService.ToolTip="Select multiple tracks" AutomationProperties.Name="Select multiple tracks"/>
                                        <Button Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE72C;" Click="OnScanLibraryClick" ToolTipService.ToolTip="Scan folder for new tracks" AutomationProperties.Name="Scan folder for new tracks"/>
                                        <Button Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE713;" Click="OnSettingsClick" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search tracks" QueryIcon="Find" TextChanged="OnSearchTextChanged" VerticalAlignment="Center" AutomationProperties.Name="Search tracks"/>
                                    <TextBlock x:Name="SearchCountText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                    <ComboBox x:Name="SortBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="OnSortChanged" VerticalAlignment="Center" AutomationProperties.Name="Sort order">
                                        <ComboBoxItem Content="Title (A-Z)"/>
                                        <ComboBoxItem Content="Title (Z-A)"/>
                                        <ComboBoxItem Content="Artist (A-Z)"/>
                                        <ComboBoxItem Content="Artist (Z-A)"/>
                                        <ComboBoxItem Content="Album (A-Z)"/>
                                        <ComboBoxItem Content="Album (Z-A)"/>
                                        <ComboBoxItem Content="Date Added (Newest)"/>
                                        <ComboBoxItem Content="Date Added (Oldest)"/>
                                        <ComboBoxItem Content="Date Modified (Newest)"/>
                                        <ComboBoxItem Content="Date Modified (Oldest)"/>
                                        <ComboBoxItem Content="Duration (Longest)"/>
                                        <ComboBoxItem Content="Duration (Shortest)"/>
                                    </ComboBox>
                                </Grid>

                                <ListView x:Name="LibraryList" Grid.Row="2" ItemsSource="{x:Bind LibraryTracks, Mode=OneWay}" SelectedItem="{x:Bind NowPlayingTrack, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnTrackItemClick" ShowsScrollingPlaceholders="False">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Track">
                                            <Grid Padding="4,6" HorizontalAlignment="Stretch" ColumnSpacing="16">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Play now" Click="OnPlayNowClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Play next" Click="OnQueueNextClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE893;"/></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Add to queue" Click="OnQueueLastClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="Edit metadata..." Click="OnEditTrackMenuClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Grid CornerRadius="4">
                                                        <Image Source="{x:Bind ArtworkImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                                        <Border Background="#88000000" Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="{x:Bind PlayPauseGlyph, Mode=OneWay}" FontSize="18" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind TitleWeight, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Artist, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayDuration}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- Edit overlay -->
                            <Grid x:Name="EditOverlay" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="{StaticResource OverlayCornerRadius}">
                                <Grid Padding="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="EditOverlayTitle" Text="Edit track info" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

                                            <StackPanel x:Name="MetadataFetchPanel" Spacing="16">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MetadataUrlBox" Grid.Column="0" PlaceholderText="Paste a Spotify, YouTube or SoundCloud link" VerticalAlignment="Center"/>
                                                    <Button x:Name="FetchMetadataBtn" Grid.Column="1" Content="Fetch" Click="OnFetchMetadataClick" VerticalAlignment="Center"/>
                                                    <ProgressRing x:Name="FetchProgressRing" Grid.Column="2" IsActive="False" Width="20" Height="20" Visibility="Collapsed" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                            </StackPanel>

                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="8" Width="160">
                                                    <Border Width="160" Height="160" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Image x:Name="EditArtworkPreview" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Button Content="Choose image..." HorizontalAlignment="Stretch" Click="OnEditArtworkClick"/>
                                                    <Button Content="Clear artwork" HorizontalAlignment="Stretch" Click="OnClearArtworkClick"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="12">
                                                    <TextBox x:Name="EditTitleBox" Header="Title" />
                                                    <TextBox x:Name="EditArtistBox" Header="Artist (separate performers with ;)" />
                                                    <TextBox x:Name="EditAlbumBox" Header="Album" />
                                                    <TextBox x:Name="EditAlbumArtistBox" Header="Album artist (separate with ;)" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <NumberBox x:Name="EditTrackBox" Grid.Column="0" Header="Track #" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox x:Name="EditDiscBox" Grid.Column="1" Header="Disc #" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox x:Name="EditYearBox" Grid.Column="2" Header="Year" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                            </Grid>

                                            <TextBox x:Name="EditGenreBox" Header="Genre (separate with ;)" />
                                            <TextBox x:Name="EditCommentBox" Header="Comment" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>

                                            <InfoBar x:Name="EditErrorBar" Severity="Error" IsOpen="False" IsClosable="False" Title="Could not save" Message=""/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                                        <Button Content="Cancel" Click="OnCancelEditClick"/>
                                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSaveEditClick"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Border x:Name="ArtworkPanel" Grid.Column="1" Background="Transparent" BorderThickness="0" CornerRadius="0,8,8,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{x:Bind NowPlayingTrack.HighResArtworkImage, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" MaxHeight="600"/>
                                <FontIcon Glyph="&#xE8D6;" FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind GetFallbackVisibility(NowPlayingTrack), Mode=OneWay}"/>
                            </Grid>
                        </Border>

                    <!-- Settings overlay: plain scrolling cards, no scaling tricks, so text stays crisp at any size. -->
                    <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Grid Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE711;" HorizontalAlignment="Right" Click="OnSettingsClick" ToolTipService.ToolTip="Close settings" AutomationProperties.Name="Close settings"/>
                            </Grid>

                            <ScrollViewer x:Name="SettingsScrollHost" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid x:Name="SettingsCards" ColumnSpacing="16" RowSpacing="16" Padding="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Appearance -->
                                    <Border x:Name="AppearanceCard" Style="{StaticResource SectionCardStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>

                                            <ToggleSwitch x:Name="UseSystemAccentSwitch" Header="Use Windows accent color" Toggled="OnUseSystemAccentToggled"/>

                                            <Expander x:Name="CustomAccentExpander" Header="Custom accent color" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="False">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Applied to buttons, sliders, switches, selection and highlights across the app." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                    <ColorPicker x:Name="AppColorPicker"
                                                                 ColorSpectrumShape="Box"
                                                                 IsMoreButtonVisible="False"
                                                                 IsColorSliderVisible="False"
                                                                 IsColorChannelTextInputVisible="True"
                                                                 IsHexInputVisible="True"
                                                                 IsAlphaEnabled="False"
                                                                 ColorChanged="OnAccentColorChanged"
                                                                 HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Expander>

                                            <StackPanel Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Interface scale" Style="{StaticResource BodyTextBlockStyle}"/>
                                                    <TextBlock x:Name="GlobalScaleText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <local:AudioProgressBar x:Name="GlobalScaleSlider" AutomationProperties.Name="Interface scale" Minimum="0.75" Maximum="1.5" Value="1.0" StepFrequency="0.05" IsThumbAlwaysVisible="True" ValueChanged="GlobalScaleSlider_ValueChanged" ScrubbingEnded="GlobalScaleSlider_ScrubbingEnded"/>
                                            </StackPanel>

                                            <ToggleSwitch x:Name="ToggleArtworkPanelSwitch" Header="Show large artwork panel" IsOn="True" Toggled="OnViewToggled"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Playback -->
                                    <Border x:Name="PlaybackCard" Style="{StaticResource SectionCardStyle}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Playback" Style="{StaticResource SubtitleTextBlockStyle}"/>

                                            <NumberBox x:Name="ShuffleMemoryBox"
                                                       Header="Shuffle memory (tracks played before a repeat is allowed)"
                                                       Minimum="0"
                                                       SpinButtonPlacementMode="Compact"
                                                       SmallChange="1"
                                                       LargeChange="10"
                                                       AcceptsExpression="False"
                                                       ValueChanged="ShuffleMemoryBox_ValueChanged"/>

                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Shuffle only tracks last modified between" Style="{StaticResource BodyTextBlockStyle}"/>
                                                <CalendarDatePicker x:Name="RandomStartPicker" Header="From" DateChanged="RandomDates_Changed"/>
                                                <CalendarDatePicker x:Name="RandomEndPicker" Header="To" DateChanged="RandomDates_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Library -->
                                    <Border x:Name="LibraryCard" Style="{StaticResource SectionCardStyle}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Library" Style="{StaticResource SubtitleTextBlockStyle}"/>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Music folder" Style="{StaticResource BodyTextBlockStyle}"/>
                                                <TextBlock x:Name="LibraryPathText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                            </StackPanel>

                                            <StackPanel Spacing="8">
                                                <Button Content="Choose music folder" Click="OnAddFolderClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
                                                <Button Content="Scan folder for new tracks" Click="OnScanLibraryClick" HorizontalAlignment="Stretch"/>
                                            </StackPanel>

                                            <ToggleSwitch x:Name="OnlineMetadataSwitch" Header="Online metadata lookup" Toggled="OnOnlineMetadataToggled"/>
                                            <TextBlock Text="Lets the track editor fetch the title and artwork from a Spotify, YouTube or SoundCloud link. Nothing is sent unless you press Fetch." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </tk:LayoutTransformControl>
    </Grid>

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24,16" Margin="16,0,16,16">
            <tk:LayoutTransformControl HorizontalAlignment="Stretch">
                <tk:LayoutTransformControl.Transform><ScaleTransform x:Name="TransportTransform" ScaleX="1.0" ScaleY="1.0"/></tk:LayoutTransformControl.Transform>
                <Grid HorizontalAlignment="Stretch" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Stretch" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="CurrentTimeText" Text="0:00" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <local:AudioProgressBar x:Name="ProgressSlider" Grid.Column="1"
                                                AutomationProperties.Name="Seek"
                                                Minimum="0" Maximum="100" Value="0"
                                                ValueChanged="ProgressSlider_ValueChanged"
                                                ScrubbingStarted="ProgressSlider_ScrubbingStarted"
                                                ScrubbingEnded="ProgressSlider_ScrubbingEnded"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Column="2" x:Name="TotalTimeText" Text="-:--" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="NowPlayingInfo" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind NowPlayingTrack.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind NowPlayingTrack.Artist, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button x:Name="ShuffleBtn" Style="{StaticResource ToolbarIconButtonStyle}" Click="ShuffleBtn_Click" ToolTipService.ToolTip="Shuffle" AutomationProperties.Name="Shuffle">
                                <TextBlock x:Name="ShuffleIcon" Text="&#xE8B1;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnPreviousClick" Content="&#xE892;" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous track"/>

                            <Button x:Name="PlayPauseButton" Style="{ThemeResource AccentButtonStyle}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="20,10" Click="OnPlayPauseClick" ToolTipService.ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20"/>
                            </Button>

                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnNextClick" Content="&#xE893;" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next track"/>
                            <Button x:Name="RepeatBtn" Style="{StaticResource ToolbarIconButtonStyle}" Click="RepeatBtn_Click" ToolTipService.ToolTip="Repeat" AutomationProperties.Name="Repeat">
                                <TextBlock x:Name="RepeatIcon" Text="&#xE8EE;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Column="2" ColumnSpacing="8" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="80" MaxWidth="160"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="QueueButton" Grid.Column="0" Style="{StaticResource ToolbarIconButtonStyle}" ToolTipService.ToolTip="Up next" AutomationProperties.Name="Up next queue">
                                <Grid>
                                    <FontIcon Glyph="&#xE8FD;" FontSize="16"/>
                                    <InfoBadge Value="{x:Bind QueueCount, Mode=OneWay}" Visibility="{x:Bind QueueBadgeVisibility, Mode=OneWay}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-14,0"/>
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight">
                                        <Grid Width="360" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <TextBlock Text="Up next" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                                                <Button Content="Clear" HorizontalAlignment="Right" Click="OnClearQueueClick" IsEnabled="{x:Bind HasQueuedTracks, Mode=OneWay}"/>
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <TextBlock Text="Nothing queued. Right-click a track and choose Play next or Add to queue." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind QueueEmptyVisibility, Mode=OneWay}"/>
                                                <ListView ItemsSource="{x:Bind UpcomingQueue}" SelectionMode="Single" CanReorderItems="True" CanDragItems="True" AllowDrop="True" ReorderMode="Enabled" MaxHeight="360" ShowsScrollingPlaceholders="False">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:Track">
                                                            <Grid ColumnSpacing="8" Padding="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{x:Bind Artist, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Tag="{x:Bind}" Click="OnRemoveQueueItemClick" Style="{StaticResource ToolbarIconButtonStyle}" Content="&#xE711;" FontSize="12" ToolTipService.ToolTip="Remove from queue" AutomationProperties.Name="Remove from queue"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <FontIcon Grid.Column="1" Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                            <local:AudioProgressBar x:Name="VolumeSlider" Grid.Column="2"
                                                    AutomationProperties.Name="Volume"
                                                    Minimum="0" Maximum="100" StepFrequency="1" Value="100"
                                                    ValueChanged="VolumeSlider_ValueChanged"
                                                    ScrubbingEnded="VolumeSlider_ScrubbingEnded"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Grid>
                </Grid>
            </tk:LayoutTransformControl>
        </Border>
    </Grid>
</Window>