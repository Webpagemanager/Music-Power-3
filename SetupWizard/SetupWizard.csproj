<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationIcon>..\Assets\icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- FIX: Removed the ".." so it looks inside the current SetupWizard folder, and removed the silent fail condition! -->
    <EmbeddedResource Include="zipping\Payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

  <!-- Publisher and Metadata set strictly to Elhoussain -->
  <PropertyGroup>
    <Version>2.2.0.0</Version>
    <FileVersion>2.2.0.0</FileVersion>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <Company>Elhoussain</Company>
    <Authors>Elhoussain</Authors>
    <Product>Music Power 3</Product>
    <Copyright>Copyright © 2026 Elhoussain</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>